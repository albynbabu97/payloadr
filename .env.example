# Create a random password here. It must be the same for both containers.
# openssl rand -hex 32
PAYLOADR_API_KEY=generate_a_random_string

# Get these from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your Telegram User ID (Get from @userinfobot). Comma-separated for multiple users.
TELEGRAM_ALLOWED_USER_IDS=

# Existing qBittorrent Web UI (same Docker network as the bot)
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USER=admin
QBITTORRENT_PASS=adminadmin